generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// The inputs are stored as given; the computed figures are stored alongside
/// them, so reopening a plan shows what was agreed rather than what today's code
/// would produce.
model Mission {
  id        String @id @default(uuid())
  /// Human-quotable booking code, unique.
  reference String @unique
  name      String

  // Inputs
  spacecraftId   String
  passengerCount Int
  /// Stored in the order the agent chose. Flight order is derived and lives in `legs`.
  destinationIds String[]
  departureDate  DateTime

  // Computed at save time
  arrivalDate     DateTime
  totalDistanceKm Float
  rangeConsumedKm Float
  durationYears   Float
  legs            Json

  /// Spacecraft attributes as they were when the mission was saved. Kept so a
  /// later change to the source data cannot silently rewrite an agreed plan.
  spacecraftSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departureDate])
  @@index([spacecraftId])
}

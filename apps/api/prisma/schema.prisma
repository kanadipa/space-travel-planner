generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A saved mission plan.
///
/// The agent-supplied inputs are stored as given. Everything else is computed by
/// the domain layer at save time and stored alongside them, so reopening a plan
/// shows the figures that were agreed rather than figures regenerated by
/// whatever the code does today.
model Mission {
  id        String @id @default(uuid())
  /// Human-quotable booking code, unique.
  reference String @unique
  name      String

  // Inputs
  spacecraftId   String
  passengerCount Int
  /// Stored in the order the agent chose. Flight order is derived and lives in `legs`.
  destinationIds String[]
  departureDate  DateTime

  // Computed at save time
  arrivalDate     DateTime
  totalDistanceKm Float
  rangeConsumedKm Float
  durationYears   Float
  /// Leg-by-leg breakdown, so an agent can see why a mission takes as long as it does.
  legs            Json

  /// Spacecraft attributes as they were when the mission was saved. Kept so a
  /// later change to the source data cannot silently rewrite an agreed plan.
  spacecraftSnapshot Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departureDate])
  @@index([spacecraftId])
}

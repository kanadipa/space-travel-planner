{
  "name": "space-mission-planner",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "npm run setup && concurrently -n api,web -c cyan,magenta \"npm:api:dev\" \"npm:web:dev\"",
    "api:dev": "npm run dev -w @smp/api",
    "web:dev": "npm run dev -w @smp/web",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run setup && npm run build -w @smp/api && playwright test",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "db:down": "docker compose down",
    "postinstall": "npm run prisma:generate -w @smp/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "concurrently": "^10.0.4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20"
  }
}
